
{
  "watch": [
    "server.js",
    "routes",
    "controllers",
    "middleware",
    "services",
    "utils"
  ],
  "ext": "js,cjs,mjs",
  "ignore": [
    "node_modules/**",
    "data/**",
    "database/**",
    "storage/**",
    "logs/**",
    "*.json",
    "*.log",
    ".env",
    ".env.local"
  ],
  "delay": 1000
}
